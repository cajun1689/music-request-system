{
  "name": "dj-bridge",
  "version": "1.14.3",
  "description": "Menubar Mac app that reads Rekordbox, Serato, or ShowKontrol/CDJ now-playing tracks and pushes them to the Casper Requests cloud API",
  "author": "Casper Requests <admin@casperrequests.com>",
  "repository": "https://github.com/cajun1689/music-request-system",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "node scripts/build-lighting-helper.js && tsc && rm -rf dist/renderer && cp -r src/renderer dist/renderer && cp src/main/preload.js dist/main/preload.js && node scripts/stamp-version.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:showkontrol": "npm run build && node --test tests/showkontrol.test.js",
    "package": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "build:lighting-helper": "node scripts/build-lighting-helper.js"
  },
  "dependencies": {
    "@s0/node-tcnet": "^0.5.1",
    "better-sqlite3-multiple-ciphers": "^12.8.0",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.2.9",
    "fengari": "^0.1.5",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.casperrequests.dj-bridge",
    "productName": "DJ Bridge",
    "publish": {
      "provider": "github",
      "owner": "cajun1689",
      "repo": "music-request-system"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "DJ Bridge uses the local DJ network for CDJ/A9 lighting sync, ShowKontrol metadata and grandMA3 lighting control."
      },
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "Contents/Resources/lighting/DJLightingReceiver"
    },
    "dmg": {
      "title": "DJ Bridge ${version}",
      "artifactName": "DJ-Bridge-${version}-mac.${ext}"
    },
    "buildDependenciesFromSource": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "assets/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "resources/lighting",
        "to": "lighting"
      }
    ],
    "afterPack": "scripts/macos-network-identity.js"
  }
}
